#!/bin/bash
# Monitor for USB device changes and toggle touchpad
# For ASUS G14 with Logitech wireless mouse
#
# Uses kernel sysfs inhibited interface instead of hyprctl keyword
# (hyprctl keyword device[...]:enabled is broken in Hyprland 0.53+)
#
# Requires udev rule: /etc/udev/rules.d/99-touchpad-inhibit.rules

STATE_FILE="/tmp/touchpad-state"

# Discover Hyprland socket at runtime (needed when running as a systemd service
# that starts before Hyprland and doesn't inherit session env vars)
ensure_hyprland_env() {
    if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
        return 0
    fi
    local sig_dir="/run/user/$(id -u)/hypr"
    if [[ -d "$sig_dir" ]]; then
        local sig
        sig=$(ls -1 "$sig_dir" 2>/dev/null | head -1)
        if [[ -n "$sig" ]]; then
            export HYPRLAND_INSTANCE_SIGNATURE="$sig"
            return 0
        fi
    fi
    return 1
}

find_touchpad_inhibit() {
    for input in /sys/class/input/input*; do
        if [[ "$(cat "$input/name" 2>/dev/null)" == "ASUF1208:00 2808:0218 Touchpad" ]]; then
            echo "$input/inhibited"
            return 0
        fi
    done
    return 1
}

INHIBIT_PATH=$(find_touchpad_inhibit)
if [[ -z "$INHIBIT_PATH" ]]; then
    echo "ERROR: Could not find touchpad sysfs path" >&2
    exit 1
fi

check_and_toggle() {
    sleep 1  # Let devices settle

    # Re-discover Hyprland socket each cycle (handles restarts)
    if ! ensure_hyprland_env; then
        return
    fi

    if hyprctl devices -j | jq -e '.mice[] | select(.name | test("logitech"; "i"))' > /dev/null 2>&1; then
        NEW_STATE="disabled"
    else
        NEW_STATE="enabled"
    fi

    LAST_STATE=$(cat "$STATE_FILE" 2>/dev/null)

    if [[ "$LAST_STATE" != "$NEW_STATE" ]]; then
        echo "$NEW_STATE" > "$STATE_FILE"
        if [[ "$NEW_STATE" == "disabled" ]]; then
            echo 1 > "$INHIBIT_PATH" 2>/dev/null
            notify-send -t 2000 "Touchpad" "Disabled (mouse detected)"
        else
            echo 0 > "$INHIBIT_PATH" 2>/dev/null
            # Hyprland doesn't auto-detect sysfs un-inhibit; kick it via keyword
            hyprctl keyword "device[asuf1208:00-2808:0218-touchpad]:enabled" true > /dev/null 2>&1
            notify-send -t 2000 "Touchpad" "Enabled (no mouse)"
        fi
    fi
}

# Initial check
check_and_toggle

# Monitor for USB changes using inotifywait on /dev
while true; do
    if command -v inotifywait &>/dev/null; then
        inotifywait -q -e create -e delete /dev 2>/dev/null
    else
        # Poll every 2 seconds if inotifywait not available
        sleep 2
    fi
    check_and_toggle
done
