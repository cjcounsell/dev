{
    "$schema": "https://opencode.ai/config.json",
    "plugins": [
        "superpowers@git+https://github.com/obra/superpowers.git"
    ],
    "model": "opencode/gpt-6-luna",
    "update": "disable",
    "mcp": {
        "servers": {
            "github": {
                "type": "remote",
                "url": "https://api.githubcopilot.com/mcp",
                "disabled": true,
                "headers": {
                    "Authorization": "Bearer {file:~/.secrets/gh_mcp_token}"
                }
            },
        }
    }
}
