#!/usr/bin/env bash

set -euo pipefail

DEV_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export DEV_ROOT

source "$DEV_ROOT/lib/common.sh"
source "$DEV_ROOT/lib/os.sh"
source "$DEV_ROOT/lib/config.sh"
source "$DEV_ROOT/lib/modules.sh"
source "$DEV_ROOT/lib/state.sh"

OS=$(detect_os)
ENV=$(detect_environment)
export OS ENV

DRY_RUN=0
FORCE=0
SKIP_CONFIRM=0
PROFILE=""

cmd_init() {
    log_info "Dev Environment Setup"
    echo ""

    if [[ -f "$DEV_ROOT/.local/machine.conf" ]]; then
        log_warn "Machine already configured."
        confirm "Overwrite?" || {
            log_info "Cancelled"
            exit 0
        }
    fi

    echo "Detected: OS=$OS, Environment=$ENV"
    echo ""
    echo "Select profile:"
    echo "  1) wsl     - WSL2 development (no GUI)"
    echo "  2) omarchy - Arch desktop with Hyprland"
    echo ""
    read -r -p "Choice [1-2]: " choice

    case "$choice" in
    1) PROFILE="wsl" ;;
    2) PROFILE="omarchy" ;;
    *) error_exit "Invalid choice" ;;
    esac

    local machine_name
    machine_name=$(prompt_input "Machine name" "$(hostname)")

    save_machine_config "$PROFILE" "$machine_name"

    log_success "Configured as: $PROFILE"
    echo ""
    echo "Next steps:"
    echo "  ./dev install    # Install modules"
    echo "  ./dev stow       # Deploy dotfiles"
}

parse_install_args() {
    args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --force | -f) FORCE=1 ;;
        --dry-run | -n) DRY_RUN=1 ;;
        --yes | -y) SKIP_CONFIRM=1 ;;
        -*) log_warn "Unknown option: $1" ;;
        *) args+=("$1") ;;
        esac
        shift
    done
}

resolve_install_modules() {
    local modules_to_install=()

    if [[ $# -eq 0 ]]; then
        modules_to_install=("${PROFILE_MODULES[@]}")
        [[ -v EXTRA_MODULES ]] && [[ ${#EXTRA_MODULES[@]} -gt 0 ]] && modules_to_install+=("${EXTRA_MODULES[@]}")

        if [[ -v SKIP_MODULES ]] && [[ ${#SKIP_MODULES[@]} -gt 0 ]]; then
            local filtered=()
            for m in "${modules_to_install[@]}"; do
                local skip=0
                for s in "${SKIP_MODULES[@]}"; do
                    [[ "$m" == "$s" ]] && skip=1 && break
                done
                [[ $skip -eq 0 ]] && filtered+=("$m")
            done
            modules_to_install=("${filtered[@]}")
        fi
    else
        modules_to_install=("$@")
    fi

    log_info "Modules: ${modules_to_install[*]}"

    all_modules=()
    for module in "${modules_to_install[@]}"; do
        if ! module_exists "$module"; then
            local suggestions
            suggestions=$(suggest_similar_modules "$module")
            if [[ -n "$suggestions" ]]; then
                log_error "Unknown module: $module"
                echo "Did you mean: $(echo "$suggestions" | tr '\n' ', ' | sed 's/,$//')"
                exit 1
            else
                error_exit "Unknown module: $module. Run './dev list' to see available modules."
            fi
        fi
        local resolved
        resolved=$(resolve_dependencies "$module")
        for m in $resolved; do
            local found=0
            for existing in "${all_modules[@]:-}"; do
                [[ "$existing" == "$m" ]] && found=1 && break
            done
            [[ $found -eq 0 ]] && all_modules+=("$m")
        done
    done

    log_debug "Order: ${all_modules[*]}"
}

execute_module_installs() {
    local installed=0
    local skipped=0
    local failed=0

    for module in "${all_modules[@]}"; do
        if module_is_installed "$module" && [[ "$FORCE" != "1" ]]; then
            if run_module "$module" check 2>/dev/null; then
                log_debug "Skipping: $module"
                ((skipped++)) || true
                continue
            fi
        fi

        log_info "Installing: $module"

        if [[ "$DRY_RUN" == "1" ]]; then
            log_dry "Would install: $module"
            ((installed++)) || true
            continue
        fi

        if run_module "$module" install; then
            module_mark_installed "$module"
            log_success "$module"
            ((installed++)) || true
        else
            log_error "Failed: $module"
            ((failed++)) || true
        fi
    done

    echo ""
    log_info "Done: $installed installed, $skipped skipped, $failed failed"

    [[ $failed -gt 0 ]] && return 1
    return 0
}

cmd_install() {
    if [[ "${1:-}" == "--help" ]]; then
        cat <<'EOF'
Usage: ./dev install [OPTIONS] [MODULE...]

Install development environment modules.

Options:
  -n, --dry-run    Preview what would be installed
  -y, --yes        Skip confirmation prompts

If no modules specified, installs all modules for current profile.
Dependencies are automatically resolved and installed first.

Examples:
  ./dev install             Install all profile modules
  ./dev install core        Install core module and dependencies
  ./dev install node rust   Install specific modules
  ./dev install --dry-run   Preview installation
EOF
        return 0
    fi

    parse_install_args "$@"
    set -- "${args[@]}"

    require_machine_config
    load_profile "$PROFILE"
    load_packages

    resolve_install_modules "$@"

    # If no specific modules requested (installing all profile modules)
    if [[ $# -eq 0 ]] && [[ "${SKIP_CONFIRM:-0}" != "1" ]]; then
        local count=${#all_modules[@]}
        if ! confirm "Install all profile modules? ($count modules)"; then
            log_info "Aborted"
            return 0
        fi
    fi

    execute_module_installs
}

cmd_stow() {
    require_command stow
    require_machine_config
    load_profile "$PROFILE"
    
    local layers
    mapfile -t layers < <(build_dotfile_layers)
    
    log_info "Syncing via Stow (Target: $HOME)"
    
    local stow_args=(-v -t "$HOME" -d "$DEV_ROOT/dotfiles" --override=".*")
    
    # Preflight check for overlaps
    local -A path_owners
    local overlaps=0
    for layer in "${layers[@]}"; do
        if [[ -d "$DEV_ROOT/dotfiles/$layer" ]]; then
            while IFS= read -r -d '' file; do
                local rel="${file#$DEV_ROOT/dotfiles/$layer/}"
                if [[ -n "${path_owners[$rel]:-}" ]]; then
                    log_debug "Overlap detected: $rel (Layers: ${path_owners[$rel]}, $layer)"
                    ((overlaps++)) || true
                fi
                path_owners["$rel"]="$layer"
            done < <(find "$DEV_ROOT/dotfiles/$layer" -type f -not -name "codemap.md" -not -name ".stow-local-ignore" -print0)
        fi
    done

    if [[ $overlaps -gt 0 ]] && [[ "$LOG_LEVEL" == "DEBUG" ]]; then
        log_debug "Total overlaps resolved by precedence: $overlaps"
    fi
    
    # Global ignores for the repo (regex matched against relative paths)
    stow_args+=(--ignore="^(codemap\.md|README\.md|\.git.*|\.stow-local-ignore|\.DS_Store|auth\.json)$")

    [[ "$DRY_RUN" == "1" ]] && stow_args+=("-n")
    [[ "$FORCE" == "1" ]] && stow_args+=(--adopt)
    
    for layer in "${layers[@]}"; do
        if [[ -d "$DEV_ROOT/dotfiles/$layer" ]]; then
            log_info "Stowing layer: $layer"
            stow "${stow_args[@]}" "$layer"
        fi
    done

    if [[ "$DRY_RUN" != "1" ]]; then
        if declare -f "${PROFILE_NAME}_post_sync" >/dev/null 2>&1; then
            log_info "Running post-sync hooks for $PROFILE_NAME"
            "${PROFILE_NAME}_post_sync"
        fi
    fi
}

cmd_promote() {
    local rel_path="${1:-}"
    if [[ -z "$rel_path" ]]; then
        error_exit "Usage: ./dev promote <path>"
    fi

    require_machine_config
    load_profile "$PROFILE"

    # Normalize path (remove leading ./ or ~/)
    rel_path="${rel_path#./}"
    rel_path="${rel_path#~/}"

    local target_layer="${MACHINE_NAME:-}"
    if [[ -z "$target_layer" ]]; then
        error_exit "Machine name not set. Run ./dev init."
    fi

    local dest_file="$DEV_ROOT/dotfiles/$target_layer/$rel_path"
    if [[ -e "$dest_file" ]]; then
        log_info "File already exists in machine layer: $target_layer/$rel_path"
        return 0
    fi

    # Find where it's currently coming from
    local current_src="$HOME/$rel_path"
    if [[ ! -L "$current_src" ]]; then
        # If it's a real file, we can just move it to the machine layer
        if [[ -f "$current_src" ]]; then
            log_info "Promoting local file to $target_layer layer"
            mkdir -p "$(dirname "$dest_file")"
            mv "$current_src" "$dest_file"
            cmd_stow
            return 0
        else
            error_exit "File not found or not a symlink: $rel_path"
        fi
    fi

    local src_file
    src_file=$(readlink -f "$current_src")

    log_info "Promoting from $(basename "$(dirname "$(dirname "$src_file")")") to $target_layer"

    if [[ "$DRY_RUN" == "1" ]]; then
        log_dry "cp $src_file $dest_file"
        return 0
    fi

    mkdir -p "$(dirname "$dest_file")"
    cp "$src_file" "$dest_file"

    log_success "Copied to $target_layer/$rel_path"
    
    # Refresh links
    cmd_stow
}

cmd_status() {
    if ! load_machine_config; then
        log_warn "Not configured. Run './dev init' first."
        return 0
    fi

    load_profile "$PROFILE"

    echo "Machine: ${MACHINE_NAME:-unknown}"
    echo "Profile: $PROFILE"
    echo "OS: $OS ($ENV)"
    echo ""

    echo "Modules:"
    local all_modules=("${PROFILE_MODULES[@]}")
    [[ -v EXTRA_MODULES ]] && [[ ${#EXTRA_MODULES[@]} -gt 0 ]] && all_modules+=("${EXTRA_MODULES[@]}")

    for module in "${all_modules[@]}"; do
        local status="○"
        local extra=""

        if module_is_installed "$module"; then
            if run_module "$module" check 2>/dev/null; then
                status="${_GREEN}●${_NC}"
            else
                status="${_YELLOW}◐${_NC}"
                extra=" (needs update)"
            fi
        fi

        load_module_meta "$module"
        printf "  %b %-15s %s%s\n" "$status" "$module" "${DESCRIPTION:-}" "$extra"
    done

    echo ""
    echo "Legend: ● installed  ◐ needs update  ○ not installed"
}

cmd_list() {
    echo "Available modules:"
    echo ""

    for module in $(list_modules); do
        load_module_meta "$module"
        local profiles_str=""
        if [[ ${#PROFILES[@]} -gt 0 ]]; then
            profiles_str=" [${PROFILES[*]}]"
        fi
        printf "  %-15s %s%s\n" "$module" "${DESCRIPTION:-}" "$profiles_str"
    done
}

cmd_show() {
    # Help check first
    if [[ "${1:-}" == "--help" ]]; then
        cat <<'EOF'
Usage: ./dev show <module>

Display detailed information about a module.

Shows:
  - Description
  - Installation status
  - Dependencies
  - Profile restrictions

Examples:
  ./dev show core     Show details for core module
  ./dev show node     Show details for node module
EOF
        return 0
    fi
    
    local module="${1:-}"
    
    if [[ -z "$module" ]]; then
        error_exit "Usage: ./dev show <module>"
    fi
    
    if ! module_exists "$module"; then
        local suggestions
        suggestions=$(suggest_similar_modules "$module")
        if [[ -n "$suggestions" ]]; then
            log_error "Unknown module: $module"
            echo "Did you mean: $(echo "$suggestions" | tr '\n' ', ' | sed 's/,$//')"
            exit 1
        else
            error_exit "Unknown module: $module. Run './dev list' to see available modules."
        fi
    fi
    
    load_module_meta "$module"
    
    echo "Module: $module"
    echo ""
    echo "  Description:  ${DESCRIPTION:-No description}"
    
    # Status
    if module_is_installed "$module"; then
        echo "  Status:       ✓ Installed"
    else
        echo "  Status:       ○ Not installed"
    fi
    
    # Dependencies
    if [[ ${#DEPENDS[@]} -gt 0 ]]; then
        echo "  Dependencies: ${DEPENDS[*]}"
    else
        echo "  Dependencies: None"
    fi
    
    # Profiles
    if [[ ${#PROFILES[@]} -gt 0 ]]; then
        echo "  Profiles:     ${PROFILES[*]}"
    else
        echo "  Profiles:     All"
    fi
}

# Suggest similar module names
# Args: $1 = invalid module name
# Outputs: up to 3 similar module names, one per line
suggest_similar_modules() {
    local input="$1"
    local suggestions=()
    local count=0
    
    for module in $(list_modules); do
        # Substring match (input contained in module or vice versa)
        if [[ "$module" == *"$input"* ]] || [[ "$input" == *"$module"* ]]; then
            suggestions+=("$module")
            ((count++))
            [[ $count -ge 3 ]] && break
        fi
    done
    
    printf '%s\n' "${suggestions[@]}"
}

cmd_update() {
    require_machine_config
    pkg_update
    log_success "Update complete"
}

cmd_doctor() {
    log_info "Diagnostics"
    echo ""

    local issues=0

    printf "OS detection: "
    if [[ "$OS" == "unknown" ]]; then
        echo "✗ Unknown"
        ((issues++))
    else
        echo "✓ $OS ($ENV)"
    fi

    printf "Machine config: "
    if [[ -f "$DEV_ROOT/.local/machine.conf" ]]; then
        echo "✓ Found"
    else
        echo "✗ Missing (run ./dev init)"
        ((issues++))
    fi

    printf "Git submodules: "
    if git -C "$DEV_ROOT" submodule status 2>/dev/null | grep -q "^-"; then
        echo "✗ Not initialized"
        ((issues++))
    else
        echo "✓ OK"
    fi

    for cmd in git zsh curl stow; do
        printf "Command '%s': " "$cmd"
        if command -v "$cmd" >/dev/null 2>&1; then
            echo "✓"
        else
            echo "✗"
            ((issues++))
        fi
    done

    # Check for broken symlinks in $HOME that point to this repo
    printf "Broken symlinks: "
    local broken_links=()
    while IFS= read -r -d '' link; do
        local target
        target=$(readlink "$link")
        if [[ "$target" == *"$DEV_ROOT"* ]] && [[ ! -e "$link" ]]; then
            broken_links+=("$link")
        fi
    done < <(find "$HOME" -maxdepth 2 -type l -print0 2>/dev/null)

    if [[ ${#broken_links[@]} -eq 0 ]]; then
        echo "✓ None found"
    else
        echo "✗ ${#broken_links[@]} found"
        for link in "${broken_links[@]}"; do
            echo "    $link -> $(readlink "$link")"
        done
        ((issues++))
    fi

    echo ""
    if [[ $issues -eq 0 ]]; then
        log_success "No issues"
    else
        log_warn "$issues issue(s) found"
    fi
}

require_machine_config() {
    if ! load_machine_config; then
        error_exit "Not configured. Run './dev init' first."
    fi
}

show_help() {
    cat <<'EOF'
Dev Environment Manager

Usage: ./dev [OPTIONS] COMMAND [ARGS...]

Commands:
  init              First-time setup
  stow              Sync dotfiles using GNU Stow
  promote <path>    Make a file machine-specific (copy to machine layer)
  install [MODULE]  Install module(s)
  status            Show status
  list              List modules
  show <module>     Show module details
  update            Update packages
  doctor            Check for issues

Options:
  -n, --dry-run     Preview changes
  -f, --force       Force operation (adopt existing files)
  -y, --yes         Skip confirmation prompts
  -v, --verbose     Debug output
  -h, --help        Show help

Examples:
  ./dev stow              Stow dotfiles
  ./dev promote .zshrc    Make .zshrc machine-specific
  ./dev --force stow      Stow and adopt existing local files
  ./dev install core      Install core module
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
    --dry-run | -n)
        DRY_RUN=1
        ;;
    --force | -f)
        FORCE=1
        ;;
    --yes | -y)
        SKIP_CONFIRM=1
        ;;
    --verbose | -v)
        LOG_LEVEL="DEBUG"
        ;;
    --help | -h)
        show_help
        exit 0
        ;;
    -*)
        error_exit "Unknown option: $1"
        ;;
    *)
        break
        ;;
    esac
    shift
done

export DRY_RUN FORCE LOG_LEVEL SKIP_CONFIRM

state_init

command="${1:-status}"
shift || true

case "$command" in
init) cmd_init "$@" ;;
install) cmd_install "$@" ;;
status) cmd_status "$@" ;;
list) cmd_list "$@" ;;
show) cmd_show "$@" ;;
update) cmd_update "$@" ;;
stow) cmd_stow "$@" ;;
promote) cmd_promote "$@" ;;
doctor) cmd_doctor "$@" ;;
*) error_exit "Unknown command: $command" ;;
esac
